      "description": "Date from the detail page; list-page timezone discrepancy is documented.",
      "sensitive": true
    },
    "description": {
      "type": "string",
      "description": "Transaction description",
      "sensitive": true
    },
    "type": {
      "type": "enum",
      "description": "Credit or debit",
      "sensitive": true,
      "values": [
        "credit",
        "debit"
      ]
    },
    "amount": {
      "type": "decimal",
      "description": "Exact decimal amount, never a binary float.",
      "sensitive": true
    },
    "currency": {
      "type": "enum",
      "description": "Sandbox currency configuration.",
      "sensitive": false,
      "values": [
        "USD"
      ]
    }
  },
  "targets": {
