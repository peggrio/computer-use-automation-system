{
  "id": "lookup_transaction",
  "name": "Look up a transaction in an account",
  "application": {
    "family": "parabank",
    "compatibility": "Pinned sandbox image; validate profile against its exact release before execution."
  },
  "requires_session": "authenticated",
  "effect": "read_only",
  "inputs": {
    "account_id": {
      "type": "identifier",
      "description": "account id",
      "sensitive": true
    },
    "transaction_id": {
      "type": "identifier",
      "description": "transaction id",
      "sensitive": true
    }
  },
  "outputs": {
    "account_id": {
      "type": "identifier",
      "description": "account id",
      "sensitive": true
    },
    "transaction_id": {
      "type": "identifier",
      "description": "transaction id",
      "sensitive": true
    },
    "date": {
      "type": "date",
      "description": "Date from the detail page; list-page timezone discrepancy is documented.",
      "sensitive": true
    },
    "description": {
      "type": "string",
      "description": "Transaction description",
      "sensitive": true
    },
    "type": {
      "type": "enum",
      "description": "Credit or debit",
      "sensitive": true,
      "values": [
        "credit",
        "debit"
      ]
    },
    "amount": {
      "type": "decimal",
      "description": "Exact decimal amount, never a binary float.",
      "sensitive": true
    },
    "currency": {
      "type": "enum",
      "description": "Sandbox currency configuration.",
      "sensitive": false,
      "values": [
        "USD"
      ]
    }
  },
  "targets": {
    "overview": {
      "description": "Loaded account overview",
      "purpose": "view",
      "cardinality": "one"
    },
    "account_link": {
      "description": "Account link matching input account_id",
      "purpose": "control",
      "cardinality": "many"
    },
    "activity": {
      "description": "Loaded activity for selected account",
      "purpose": "view",
      "cardinality": "one"
    },
    "account_number": {
      "description": "Displayed activity account number",
      "purpose": "data",
      "cardinality": "one"
    },
    "account_transaction": {
      "description": "Activity link matching input transaction_id",
      "purpose": "control",
      "cardinality": "many"
    },
    "find_transactions": {
      "description": "Navigation to transaction search",
      "purpose": "control",
      "cardinality": "one"
    },
    "search": {
      "description": "Loaded search form and account options",
      "purpose": "view",
      "cardinality": "one"
    },
    "account_select": {
      "description": "Search account selector",
      "purpose": "control",
      "cardinality": "one"
    },
    "transaction_input": {
      "description": "Search by transaction ID input",
      "purpose": "control",
      "cardinality": "one"
    },
    "search_by_id": {
      "description": "Submit ID search, not the other search forms",
      "purpose": "control",
      "cardinality": "one"
    },
    "results": {
      "description": "Completed transaction search result view",
      "purpose": "view",
      "cardinality": "one"
    },
    "result_transaction": {
      "description": "Result link matching input transaction_id",
      "purpose": "control",
      "cardinality": "many"
    },
    "details": {
      "description": "Loaded transaction details",
      "purpose": "view",
      "cardinality": "one"
    },
    "detail_id": {
      "description": "Displayed transaction ID",
      "purpose": "data",
      "cardinality": "one"
    },
    "detail_date": {
      "description": "Displayed detail date",
      "purpose": "data",
      "cardinality": "one"
    },
    "detail_description": {
      "description": "Displayed description",
      "purpose": "data",
      "cardinality": "one"
    },
    "detail_type": {
      "description": "Displayed credit/debit type",
      "purpose": "data",
      "cardinality": "one"
    },
    "detail_amount": {
      "description": "Displayed amount",
      "purpose": "data",
      "cardinality": "one"
    }
  },
  "known_outcomes": {
    "account_not_available": "Requested account is not listed in the completed overview.",
    "transaction_not_found_in_account": "Requested transaction is absent from the fully loaded account activity. No claim about other accounts."
  },
  "success_conditions": [
    {
      "predicate": "ready",
      "target": "details"
    },
    {
      "predicate": "text_equals",
      "target": "detail_id",
      "expected": {
        "input": "transaction_id"
      }
    }
  ],
  "goal": "Look up transaction_id in account_id and return its verified details without changing banking data.",
  "extraction": {
    "type": "extract",
    "fields": {
      "account_id": {
        "input": "account_id"
      },
      "transaction_id": {
        "target": "detail_id",
        "transform": "text"
      },
      "date": {
        "target": "detail_date",
        "transform": "date_mm_dd_yyyy"
      },
      "description": {
        "target": "detail_description",
        "transform": "text"
      },
      "type": {
        "target": "detail_type",
        "transform": "credit_debit"
      },
      "amount": {
        "target": "detail_amount",
        "transform": "usd_amount"
      },
      "currency": {
        "literal": "USD"
      }
    }
  },
  "constraints": [
    "Establish that the requested transaction belongs to the requested account using the account activity UI. Global transaction search alone cannot establish membership.",
    "Explicitly apply both input references to the search form during this run, even if a field already has the requested value, so the learned capability works with different inputs.",
    "Finish only when membership, transaction identity, and the detail fields can be verified."
  ]
}
