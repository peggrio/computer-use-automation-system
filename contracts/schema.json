{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Computer-use contracts v1",
  "oneOf": [
    {
      "$ref": "#/$defs/capability"
    },
    {
      "$ref": "#/$defs/profile"
    },
    {
      "$ref": "#/$defs/invocation"
    },
    {
      "$ref": "#/$defs/run_result"
    }
  ],
  "$defs": {
    "field": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "identifier",
                "string",
                "decimal",
                "date",
                "integer",
                "boolean"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "sensitive": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "description",
            "sensitive"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "sensitive": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "values",
            "description",
            "sensitive"
          ],
          "additionalProperties": false
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": [
                "string",
                "integer",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "predicate": {
              "enum": [
                "ready",
                "visible"
              ]
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "predicate",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "predicate": {
              "enum": [
                "text_equals",
                "value_equals"
              ]
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "expected": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "predicate",
            "target",
            "expected"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "predicate": {
              "const": "count_equals"
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "expected": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "predicate",
            "target",
            "expected"
          ],
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "transform": {
              "enum": [
                "text",
                "date_mm_dd_yyyy",
                "usd_amount",
                "credit_debit"
              ]
            }
          },
          "required": [
            "target",
            "transform"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": [
                "string",
                "integer",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "wait",
                "click"
              ]
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "fill",
                "select"
              ]
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "type",
            "target",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "extract"
            },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/source"
              }
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 0
        },
        "ensures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "$ref": "#/$defs/condition"
              },
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "required": [
              "when",
              "code"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "retry": {
          "type": "object",
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "delay_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "max_attempts",
            "delay_ms"
          ],
          "additionalProperties": false
        },
        "on_failure": {
          "enum": [
            "fail",
            "intervene"
          ]
        }
      },
      "required": [
        "id",
        "description",
        "action",
        "requires",
        "ensures",
        "outcomes",
        "timeout_ms",
        "retry",
        "on_failure"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "capability"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "design_example",
                "llm_discovery"
              ]
            },
            "evidence_run_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "source",
            "evidence_run_id"
          ],
          "additionalProperties": false
        },
        "application": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "compatibility": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "family",
            "compatibility"
          ],
          "additionalProperties": false
        },
        "requires_session": {
          "enum": [
            "authenticated",
            "anonymous"
          ]
        },
        "effect": {
          "enum": [
            "read_only",
            "reversible_write",
            "irreversible_write"
          ]
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "cardinality": {
                "enum": [
                  "one",
                  "many"
                ]
              },
              "purpose": {
                "enum": [
                  "view",
                  "control",
                  "data"
                ]
              }
            },
            "required": [
              "description",
              "cardinality",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "known_outcomes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        },
        "success_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "schema_version",
        "id",
        "version",
        "name",
        "description",
        "provenance",
        "application",
        "requires_session",
        "effect",
        "inputs",
        "outputs",
        "targets",
        "known_outcomes",
        "steps",
        "success_conditions"
      ],
      "additionalProperties": false
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "strategy": {
              "const": "role"
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "strategy",
            "role",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "strategy": {
              "const": "css"
            },
            "selector": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "strategy",
            "selector"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "strategy": {
              "const": "accessibility_id"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "strategy",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          },
          "minItems": 1
        },
        "filters": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "text_equals"
                  },
                  "value": {
                    "$ref": "#/$defs/value"
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "link_query_equals"
                  },
                  "parameter": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "$ref": "#/$defs/value"
                  }
                },
                "required": [
                  "type",
                  "parameter",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scope",
        "candidates",
        "filters",
        "rationale"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "surface_profile"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "capability": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "application": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "release": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "family",
            "release"
          ],
          "additionalProperties": false
        },
        "adapter": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "contract_version": {
              "const": "1.0.0"
            }
          },
          "required": [
            "name",
            "contract_version"
          ],
          "additionalProperties": false
        },
        "readiness_contract": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        },
        "readiness": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "rule",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "schema_version",
        "id",
        "version",
        "capability",
        "application",
        "adapter",
        "readiness_contract",
        "bindings",
        "readiness"
      ],
      "additionalProperties": false
    },
    "pinned_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "invocation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "invocation"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "$ref": "#/$defs/pinned_ref"
        },
        "profile": {
          "$ref": "#/$defs/pinned_ref"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_duration_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "max_actions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "max_duration_ms",
            "max_actions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "schema_version",
        "run_id",
        "capability",
        "profile",
        "session_id",
        "policy_id",
        "inputs",
        "limits"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_input",
            "policy_denied",
            "target_missing",
            "target_ambiguous",
            "precondition_failed",
            "checkpoint_failed",
            "session_expired",
            "permission_denied",
            "load_timeout",
            "app_error",
            "adapter_unsupported",
            "output_invalid",
            "limit_exceeded",
            "indeterminate_action"
          ]
        },
        "step_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "code",
        "step_id",
        "expected",
        "observed",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "run_result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "run_result"
            },
            "schema_version": {
              "const": "1.0.0"
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "capability": {
              "$ref": "#/$defs/pinned_ref"
            },
            "profile": {
              "$ref": "#/$defs/pinned_ref"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "status": {
              "const": "succeeded"
            },
            "outputs": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "required": [
            "kind",
            "schema_version",
            "run_id",
            "capability",
            "profile",
            "evidence_refs",
            "status",
            "outputs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "run_result"
            },
            "schema_version": {
              "const": "1.0.0"
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "capability": {
              "$ref": "#/$defs/pinned_ref"
            },
            "profile": {
              "$ref": "#/$defs/pinned_ref"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "status": {
              "const": "business_outcome"
            },
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "step_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "schema_version",
            "run_id",
            "capability",
            "profile",
            "evidence_refs",
            "status",
            "code",
            "step_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "run_result"
            },
            "schema_version": {
              "const": "1.0.0"
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "capability": {
              "$ref": "#/$defs/pinned_ref"
            },
            "profile": {
              "$ref": "#/$defs/pinned_ref"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "status": {
              "const": "failed"
