        {
          "strategy": "css",
          "selector": "button#findById"
        }
      ],
      "filters": [],
      "rationale": "Four buttons share the same accessible name; the existing ID disambiguates the ID-search action."
    },
    "results": {
      "scope": null,
      "candidates": [
