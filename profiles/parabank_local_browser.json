{
  "kind": "surface_profile",
  "schema_version": "1.0.0",
  "id": "parabank_local_browser",
  "version": "0.1.0",
  "capability": {
    "id": "lookup_transaction",
    "version": "0.1.0"
  },
  "application": {
    "family": "parabank",
    "release": "sha256:747453a0c00b52ed36c7c55aa842a6e9e4a761f70ad577ec07b1f6cbee77e0e5"
  },
  "adapter": {
    "name": "playwright_browser",
    "contract_version": "1.0.0"
  },
  "readiness_contract": "parabank_browser_v1",
  "bindings": {
    "overview": {
      "scope": null,
      "candidates": [
        {
          "strategy": "css",
          "selector": "#overviewAccountsApp"
        }
      ],
      "filters": [],
      "rationale": "Existing application markup; no test IDs are added."
    },
    "account_link": {
      "scope": "overview",
      "candidates": [
        {
          "strategy": "css",
          "selector": "#accountTable tbody a"
        }
      ],
      "filters": [
        {
          "type": "link_query_equals",
          "parameter": "id",
          "value": {
            "input": "account_id"
          }
        }
      ],
      "rationale": "Existing application markup; no test IDs are added."
    },
    "activity": {
      "scope": null,
      "candidates": [
        {
          "strategy": "css",
          "selector": "#rightPanel"
        }
      ],
      "filters": [],
      "rationale": "Existing application markup; no test IDs are added."
    },
    "account_number": {
      "scope": "activity",
      "candidates": [
        {
          "strategy": "css",
          "selector": "#accountDetails #accountId"
        }
      ],
      "filters": [],
      "rationale": "Existing application markup; no test IDs are added."
    },
    "account_transaction": {
      "scope": "activity",
      "candidates": [
