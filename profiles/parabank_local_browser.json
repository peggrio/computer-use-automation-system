      "filters": [
        {
          "type": "link_query_equals",
          "parameter": "id",
          "value": {
            "input": "transaction_id"
          }
        }
      ],
      "rationale": "Existing application markup; no test IDs are added."
    },
    "find_transactions": {
      "scope": null,
      "candidates": [
        {
          "strategy": "role",
          "role": "link",
          "name": {
            "literal": "Find Transactions"
          }
        }
      ],
      "filters": [],
      "rationale": "Existing application markup; no test IDs are added."
    },
    "search": {
      "scope": null,
      "candidates": [
        {
          "strategy": "css",
          "selector": "#formContainer"
        }
      ],
      "filters": [],
      "rationale": "Existing application markup; no test IDs are added."
    },
