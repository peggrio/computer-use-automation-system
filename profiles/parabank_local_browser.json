    },
    "detail_id": {
      "scope": "details",
      "candidates": [
        {
          "strategy": "css",
          "selector": "tr:has(td:first-child > b:text-is(\"Transaction ID:\")) > td:nth-child(2)"
        }
      ],
      "filters": [],
      "rationale": "Find the value by its row label in a legacy table, not a global row index."
    },
    "detail_date": {
